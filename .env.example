# Copy this file to .env and replace every change-me value before deployment.

# PostgreSQL database name, role, and a strong unique password. PostgreSQL is not published to the host.
POSTGRES_DB=grinding_thunder
POSTGRES_USER=grinding_thunder
POSTGRES_PASSWORD=change-me-use-a-long-random-database-password

# At least 32 random characters used to sign Admin and player JWTs.
JWT_SIGNING_KEY=change-me-use-at-least-32-random-characters

# One-time, idempotent first-Admin bootstrap credentials. Remove these values after the account exists.
ADMIN_BOOTSTRAP_USERNAME=initial-admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-use-a-long-random-admin-password

# Comma-separated browser origins allowed by API CORS. Do not include paths or trailing slashes.
CORS_ALLOWED_ORIGINS=https://grindthunder.mydomain.com,https://admin.grindthunder.mydomain.com

# Public API origin compiled into the browser-facing Next.js bundle. Rebuild Web after changing it.
NEXT_PUBLIC_API_URL=https://api.grindthunder.mydomain.com

# Localhost-only ports consumed by the native host Nginx reverse proxy.
WEB_HOST_PORT=3000
API_HOST_PORT=5034
ADMIN_HOST_PORT=5035
