@page "/Accounts/Create"
@model GrindingThunder.Admin.Pages.Accounts.CreateModel
@{ ViewData["Title"] = "Create Account"; }
<div class="page-header"><h1 class="page-title">Create Account</h1></div>
<div class="card catalog-form mt-3"><div class="card-body"><form method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="Input.Username" class="form-label"></label><input asp-for="Input.Username" class="form-control" autofocus /><span asp-validation-for="Input.Username"></span></div>
    <div class="mb-3"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" type="password" class="form-control" /><span asp-validation-for="Input.Password"></span></div>
    <div class="mb-3"><span class="form-label">Roles</span>
        @foreach (var role in SupportedAdminRoles.All)
        {
            <label class="form-check"><input class="form-check-input" type="checkbox" name="Input.Roles" value="@role" @(Model.Input.Roles.Contains(role) ? "checked" : "") /><span class="form-check-label">@role</span></label>
        }
    </div>
    <div class="btn-list"><button class="btn btn-primary" type="submit">Create</button><a class="btn" asp-page="Index">Cancel</a></div>
</form></div></div>
