@page "/Catalog"
@model GrindingThunder.Admin.Pages.CatalogModel
@{
    ViewData["Title"] = "Vehicle Catalog";
}

<div class="card" style="max-width: 650px; margin: 2rem auto; text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🚜</div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: #fff;">Vehicle Catalog Management</h1>
    <span class="badge badge-pill-outline" style="align-self: center; margin-bottom: 1rem;">Scheduled for Batch 18</span>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
        Back-office CRUD screens for Nations, Vehicle Types, Vehicles, Game Updates, and Research Trees will be available here in Batch 18.
    </p>
    <div>
        <a asp-page="/Index" class="btn btn-primary">Return to Dashboard</a>
    </div>
</div>

