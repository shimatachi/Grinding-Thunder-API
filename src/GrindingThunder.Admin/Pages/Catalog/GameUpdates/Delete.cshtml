@page "/Catalog/Game-Updates/{id:guid}/Delete"
@model GrindingThunder.Admin.Pages.Catalog.GameUpdates.DeleteModel
@{ ViewData["Title"] = "Delete Game Update"; }
<partial name="/Pages/Catalog/_CatalogNav.cshtml" />
<div class="page-header"><h1 class="page-title">Delete Game Update</h1></div>
@if (Model.Message is not null) { <div class="alert @(Model.IsMissing ? "alert-warning" : "alert-danger") mt-3">@Model.Message</div> }
@if (Model.Item is not null) { <div class="card catalog-form mt-3"><div class="card-body"><p>Delete game update <strong>@Model.Item.Version</strong>?</p><p class="text-secondary">This succeeds only when it is not referenced by a research tree version.</p><form method="post"><button class="btn btn-danger" type="submit">Delete game update</button> <a class="btn" asp-page="Index">Cancel</a></form></div></div> } else { <a class="btn mt-3" asp-page="Index">Back to game updates</a> }
