@page "/Catalog/Research-Trees/{id:guid}/Delete"
@model GrindingThunder.Admin.Pages.Catalog.ResearchTrees.DeleteModel
@{ ViewData["Title"] = "Delete Research Tree"; }
<partial name="/Pages/Catalog/_CatalogNav.cshtml" />
<div class="page-header"><h1 class="page-title">Delete Research Tree</h1></div>
@if (Model.Message is not null) { <div class="alert @(Model.IsMissing ? "alert-warning" : "alert-danger") mt-3">@Model.Message</div> }
@if (Model.Item is not null) { <div class="card catalog-form mt-3"><div class="card-body"><p>Delete the <strong>@Model.Item.NationName — @Model.Item.VehicleTypeName</strong> research tree?</p><p class="text-secondary">This succeeds only when it has no associated versions.</p><form method="post"><button class="btn btn-danger" type="submit">Delete research tree</button> <a class="btn" asp-page="Index">Cancel</a></form></div></div> } else { <a class="btn mt-3" asp-page="Index">Back to research trees</a> }
