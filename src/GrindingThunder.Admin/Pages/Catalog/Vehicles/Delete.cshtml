@page "/Catalog/Vehicles/{id:guid}/Delete"
@model GrindingThunder.Admin.Pages.Catalog.Vehicles.DeleteModel
@{ ViewData["Title"] = "Delete Vehicle"; }
<partial name="/Pages/Catalog/_CatalogNav.cshtml" />
<div class="page-header"><h1 class="page-title">Delete Vehicle</h1></div>
@if (Model.Message is not null) { <div class="alert @(Model.IsMissing ? "alert-warning" : "alert-danger") mt-3">@Model.Message</div> }
@if (Model.Item is not null) { <div class="card catalog-form mt-3"><div class="card-body"><p>Delete vehicle <strong>@Model.Item.Name</strong>?</p><p class="text-secondary">This succeeds only when it is not referenced by a research tree entry.</p><form method="post"><button class="btn btn-danger" type="submit">Delete vehicle</button> <a class="btn" asp-page="Index">Cancel</a></form></div></div> } else { <a class="btn mt-3" asp-page="Index">Back to vehicles</a> }
