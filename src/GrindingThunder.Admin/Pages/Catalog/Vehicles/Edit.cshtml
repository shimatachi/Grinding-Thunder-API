@page "/Trees/{nationId:guid}/{researchTreeId:guid}/Vehicles/{id:guid}/Edit"
@model GrindingThunder.Admin.Pages.Catalog.Vehicles.EditModel
@{ ViewData["Title"] = "Edit Vehicle"; }
<partial name="/Pages/Trees/_TreeNav.cshtml" model="Model.Tree" />
<div class="text-secondary mb-2">@Model.Tree.NationName - @Model.Tree.VehicleTypeName</div>
<div class="page-header"><h1 class="page-title">Edit Vehicle</h1></div>
@if (Model.NotFoundMessage is not null) { <div class="alert alert-warning mt-3">@Model.NotFoundMessage</div><a class="btn" asp-page="Index" asp-route-nationId="@Model.Tree.NationId" asp-route-researchTreeId="@Model.Tree.Id">Back to vehicles</a> }
else { <div class="card catalog-form mt-3"><div class="card-body"><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name"></span></div>
<div class="mb-3"><label asp-for="Input.ImageUrl" class="form-label"></label><input asp-for="Input.ImageUrl" class="form-control" /><span asp-validation-for="Input.ImageUrl"></span></div>
<div class="mb-3"><label asp-for="Input.WikiUrl" class="form-label"></label><input asp-for="Input.WikiUrl" class="form-control" placeholder="https://wiki.warthunder.com/…" /><span asp-validation-for="Input.WikiUrl"></span><div class="form-hint">Optional absolute War Thunder Wiki URL.</div></div>
<div class="btn-list"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn" asp-page="Index" asp-route-nationId="@Model.Tree.NationId" asp-route-researchTreeId="@Model.Tree.Id">Cancel</a></div></form></div></div> }
