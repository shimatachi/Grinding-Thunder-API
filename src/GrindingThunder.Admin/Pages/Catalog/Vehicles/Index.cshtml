@page "/Trees/{nationId:guid}/{researchTreeId:guid}/Vehicles"
@model GrindingThunder.Admin.Pages.Catalog.Vehicles.IndexModel
@{ ViewData["Title"] = "Vehicles"; }
<partial name="/Pages/Trees/_TreeNav.cshtml" model="Model.Tree" />
<div class="text-secondary mb-2">@Model.Tree.NationName - @Model.Tree.VehicleTypeName</div>
<div class="page-header"><div class="row align-items-center"><div class="col"><h1 class="page-title">Vehicles</h1></div>@if (Model.CanEdit) { <div class="col-auto ms-auto"><a class="btn btn-primary" asp-page="Create" asp-route-nationId="@Model.Tree.NationId" asp-route-researchTreeId="@Model.Tree.Id">Create vehicle</a></div> }</div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success mt-3">@success</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger mt-3">@Model.ErrorMessage</div> }
<div class="card mt-3"><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Image</th><th>Name</th><th>Research tree</th><th>Image URL</th><th class="catalog-actions">Actions</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr><td>@if (!string.IsNullOrWhiteSpace(item.ImageUrl)) { <img class="vehicle-thumbnail" src="@item.ImageUrl" alt="" /> }</td><td>@item.Name</td><td>@item.NationName / @item.VehicleTypeName</td><td class="text-secondary text-truncate" style="max-width: 28rem">@(item.ImageUrl ?? "—")</td><td class="catalog-actions">@if (Model.CanEdit) { <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-nationId="@Model.Tree.NationId" asp-route-researchTreeId="@Model.Tree.Id" asp-route-id="@item.Id">Edit</a> } @if (Model.IsAdmin) { <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-nationId="@Model.Tree.NationId" asp-route-researchTreeId="@Model.Tree.Id" asp-route-id="@item.Id">Delete</a> }</td></tr> }
</tbody></table>@if (Model.Items.Count == 0 && Model.ErrorMessage is null) { <div class="empty-message">No vehicles have been created.</div> }</div></div>
