@page "/"
@model GrindingThunder.Admin.Pages.IndexModel
@{ ViewData["Title"] = "Dashboard"; }
<div class="page-header"><div><h1 class="page-title">Admin Dashboard</h1><div class="text-secondary mt-1">War Thunder progression back-office management.</div></div></div>
@if (Model.IsApiConnected)
{
    <div class="alert alert-success mt-3 d-flex justify-content-between"><div><strong>API connected.</strong> Session verified against <code>@Model.ApiBaseUrl/api/auth/me</code>.</div><span class="badge bg-green-lt">ONLINE</span></div>
}
else
{
    <div class="alert alert-danger mt-3 d-flex justify-content-between"><div><strong>API communication error.</strong> @(Model.ApiErrorMessage ?? "Could not reach backend REST API.")</div><span class="badge bg-red-lt">OFFLINE</span></div>
}
<div class="row row-cards mt-1">
    <div class="col-md-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Session Profile</h2></div><div class="card-body">
        <dl class="row"><dt class="col-5">Username</dt><dd class="col-7" id="session-username">@Model.Username</dd><dt class="col-5">Granted roles</dt><dd class="col-7" id="session-roles">@string.Join(", ", Model.LocalRoles)</dd><dt class="col-5">API identity</dt><dd class="col-7">@(Model.ApiUser?.Username ?? "Unverified")</dd><dt class="col-5">Backend URL</dt><dd class="col-7"><code>@Model.ApiBaseUrl</code></dd></dl>
    </div></div></div>
    <div class="col-md-6"><div class="card h-100"><div class="card-header"><h2 class="card-title">Back-Office Modules</h2></div><div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action" asp-page="/Catalog"><strong>Vehicle Catalog</strong><div class="text-secondary small">Nations, vehicle types, vehicles, updates, and research trees</div></a>
        <a class="list-group-item list-group-item-action" asp-page="/Trees"><strong>Tech Tree Versions</strong><div class="text-secondary small">Batch 19 — drafts, ranks, entries, layout, and prerequisites</div></a>
        <a class="list-group-item list-group-item-action" asp-page="/Import"><strong>Data Import & Diff</strong><div class="text-secondary small">Batch 20 — CSV/XLSX validation, import, diff, and publish</div></a>
    </div></div></div>
</div>
