<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} - " : "")@(User.Identity?.IsAuthenticated == true ? "Grinding Thunder Admin" : "Grinding Thunder")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.0.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="layout-fluid">
    <header class="navbar navbar-expand-md navbar-dark d-print-none">
        <div class="container-xl">
            <a class="navbar-brand navbar-brand-autodark" asp-page="@(User.Identity?.IsAuthenticated == true ? "/Index" : "/Tree")">Grinding Thunder</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav flex-row order-md-last ms-auto">
                    <li class="nav-item d-flex align-items-center gap-2 me-3">
                        <span class="text-secondary">@User.Identity.Name</span>
                        @foreach (var role in User.FindAll(ClaimTypes.Role).Select(c => c.Value).Distinct())
                        {
                            var badgeClass = role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ? "bg-red-lt" :
                                role.Equals("Publisher", StringComparison.OrdinalIgnoreCase) ? "bg-blue-lt" : "bg-green-lt";
                            <span class="badge @badgeClass">@role</span>
                        }
                    </li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Logout">
                            <button type="submit" class="btn btn-outline-danger btn-sm" id="logout-button">Logout</button>
                        </form>
                    </li>
                </ul>
            }
        </div>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        <div class="navbar-expand-md">
            <div class="collapse navbar-collapse show" id="navbar-menu">
                <div class="navbar">
                    <div class="container-xl">
                        <ul class="navbar-nav">
                            <li class="nav-item @(currentPage == "/Index" ? "active" : "")"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                            <li class="nav-item @(currentPage.Equals("/Trees", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Trees/", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Catalog/Vehicles", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Catalog/ResearchTrees", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a class="nav-link" asp-page="/Trees" asp-route-nationId="" asp-route-researchTreeId="">Tech Trees</a></li>
                            @if (User.IsInRole("Editor") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item @(currentPage == "/Import" ? "active" : "")"><a class="nav-link" asp-page="/Import">Import</a></li>
                                <li class="nav-item @(currentPage.StartsWith("/Catalog/GameUpdates", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a class="nav-link" asp-page="/Catalog/GameUpdates/Index">Game Updates</a></li>
                                <li class="nav-item dropdown @(currentPage == "/Administration" || currentPage.StartsWith("/Catalog/Nations", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Catalog/VehicleTypes", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Accounts", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                                    <a class="nav-link dropdown-toggle" href="#administration-menu" data-bs-toggle="dropdown" role="button" aria-expanded="false">Administration</a>
                                    <div class="dropdown-menu" id="administration-menu">
                                        <a class="dropdown-item" asp-page="/Administration">Overview</a>
                                        <a class="dropdown-item" asp-page="/Catalog/Nations/Index">Nations</a>
                                        <a class="dropdown-item" asp-page="/Catalog/VehicleTypes/Index">Categories</a>
                                        @if (User.IsInRole("Admin")) { <a class="dropdown-item" asp-page="/Accounts/Index">Admin Accounts</a> }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="page-wrapper">
        <main class="page-body"><div class="container-xl">@RenderBody()</div></main>
        <footer class="footer footer-transparent d-print-none"><div class="container-xl text-secondary">@(User.Identity?.IsAuthenticated == true ? "Grinding Thunder Admin Back-Office" : "Grinding Thunder Research Trees")</div></footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@@1.0.0/dist/js/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
