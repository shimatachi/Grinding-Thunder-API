@page "/Trees/{nationId:guid?}/{researchTreeId:guid?}"
@model GrindingThunder.Admin.Pages.TreesModel
@{ ViewData["Title"] = "Tech Trees"; }
<div class="page-header"><h1 class="page-title">Tech Trees</h1><div class="text-secondary">Choose a nation, then a category to manage its vehicles and versions.</div></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success mt-3">@success</div> }
@if (TempData["TreeErrorMessage"] is string treeError) { <div class="alert alert-danger mt-3">@treeError</div> }
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger mt-3">@Model.ErrorMessage</div> }

@if (Model.SelectedNation is null)
{
    <div class="row row-cards mt-3">
    @foreach (var nation in Model.Nations)
    {
        <div class="col-md-4"><a class="card card-link" asp-page="/Trees" asp-route-nationId="@nation.Id" asp-route-researchTreeId=""><div class="card-body"><h2 class="card-title">@nation.Name</h2><div class="text-secondary">@nation.ResearchTrees.Count categories</div></div></a></div>
    }
    @if (Model.Nations.Count == 0 && Model.ErrorMessage is null) { <p class="text-secondary">No nations exist. Add a nation under Administration to begin.</p> }
    </div>
}
else if (Model.SelectedTree is null)
{
    <nav aria-label="Breadcrumb" class="mt-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-page="/Trees" asp-route-nationId="" asp-route-researchTreeId="">Tech Trees</a></li><li class="breadcrumb-item active">@Model.SelectedNation.Name</li></ol></nav>
    <h2>@Model.SelectedNation.Name - Categories</h2>
    <div class="row row-cards mt-3">
    @foreach (var tree in Model.SelectedNation.ResearchTrees.OrderBy(t => t.VehicleTypeName))
    {
        <div class="col-md-4"><div class="card"><div class="card-body"><h3 class="card-title">@Model.SelectedNation.Name - @tree.VehicleTypeName</h3><div class="btn-list">
            <a class="btn btn-primary" asp-page="/Catalog/Vehicles/Index" asp-route-nationId="@Model.SelectedNation.Id" asp-route-researchTreeId="@tree.Id">Vehicles</a>
            <a class="btn btn-outline-primary" asp-page="/Trees" asp-route-nationId="@Model.SelectedNation.Id" asp-route-researchTreeId="@tree.Id">Versions</a>
        </div></div></div></div>
    }
    @if (Model.SelectedNation.ResearchTrees.Count == 0) { <p class="text-secondary">No categories are enabled for this nation yet.</p> }
    </div>
    @if (Model.CanEdit)
    {
        <div class="card mt-3"><div class="card-header"><h3 class="card-title">Enable category</h3></div><div class="card-body">
        <div asp-validation-summary="All" class="text-danger"></div>
        @if (Model.AvailableCategories.Count > 0)
        {
            <form method="post" asp-page="/Trees" asp-page-handler="EnableCategory" asp-route-nationId="@Model.SelectedNation.Id" class="row g-2 align-items-end">
                <div class="col-auto"><label for="vehicleTypeId" class="form-label">Category</label><select name="vehicleTypeId" id="vehicleTypeId" class="form-select">
                @foreach (var category in Model.AvailableCategories) { <option value="@category.Id">@category.Name</option> }
                </select></div><div class="col-auto"><button type="submit" class="btn btn-primary">Enable category</button></div>
            </form>
        }
        else if (Model.ErrorMessage is null) { <p class="text-secondary mb-0">All master categories are already enabled. Manage the master list under Administration.</p> }
        </div></div>
    }
}

@if (Model.SelectedTree is not null)
{
    <div class="mt-3"><partial name="/Pages/Trees/_TreeNav.cshtml" model="Model.SelectedTree" /></div>
    <h2>@Model.SelectedTree.NationName - @Model.SelectedTree.VehicleTypeName</h2>
    if (Model.CanEdit)
    {
        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Create draft version</h3><div class="card-subtitle">Blank draft for @Model.SelectedTree.NationName @Model.SelectedTree.VehicleTypeName</div></div>
            <div class="card-body">
                <form method="post" asp-page-handler="CreateDraft" class="row g-2 align-items-end">
                    <input type="hidden" name="researchTreeId" value="@Model.SelectedTreeId" />
                    <div class="col-auto"><label class="form-label" for="gameUpdateId">Game update</label>
                        <select name="gameUpdateId" id="gameUpdateId" class="form-select">
                            @if (Model.GameUpdates.Count == 0)
                            {
                                <option value="">No game updates exist</option>
                            }
                            @foreach (var update in Model.GameUpdates)
                            {
                                <option value="@update.Id">@update.Version@(string.IsNullOrWhiteSpace(update.Name) ? string.Empty : $" — {update.Name}")</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto"><button type="submit" class="btn btn-primary">Create draft</button></div>
                </form>
            </div>
        </div>
    }

    <div class="card mt-3">
        <div class="card-header"><h3 class="card-title">Versions</h3></div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead><tr><th>Game update</th><th>Status</th><th>Ranks</th><th class="catalog-actions">Actions</th></tr></thead>
                <tbody>
                @if (Model.Versions.Count == 0)
                {
                    <tr><td colspan="4" class="empty-message">No versions exist for this research tree yet.</td></tr>
                }
                @foreach (var version in Model.Versions)
                {
                    <tr>
                        <td><strong>@version.UpdateVersion</strong></td>
                        <td><span class="badge @(version.IsPublished ? "bg-green-lt" : "bg-blue-lt")">@(version.IsPublished ? "Published" : "Draft")</span></td>
                        <td>@version.RankCount</td>
                        <td class="catalog-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Trees/Version" asp-route-versionId="@version.Id">Open</a>
                            @if (Model.CanEdit && Model.GameUpdates.Count > 0)
                            {
                                <form method="post" asp-page-handler="Clone" class="d-inline-flex gap-1 align-items-center">
                                    <input type="hidden" name="versionId" value="@version.Id" />
                                    <input type="hidden" name="researchTreeId" value="@Model.SelectedTreeId" />
                                    <select name="targetGameUpdateId" class="form-select form-select-sm">
                                        @foreach (var update in Model.GameUpdates)
                                        {
                                            <option value="@update.Id">@update.Version</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Clone</button>
                                </form>
                            }
                            @if (!version.IsPublished && Model.IsAdmin)
                            {
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Delete this draft version and all its ranks, entries, and prerequisites?');">
                                    <input type="hidden" name="versionId" value="@version.Id" />
                                    <input type="hidden" name="researchTreeId" value="@Model.SelectedTreeId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete draft</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
