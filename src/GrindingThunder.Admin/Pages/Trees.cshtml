@page "/Trees"
@model GrindingThunder.Admin.Pages.TreesModel
@{
    ViewData["Title"] = "Tech Tree Editor";
}

<div class="card" style="max-width: 650px; margin: 2rem auto; text-align: center;">
    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">🌲</div>
    <h1 style="font-size: 1.5rem; margin-bottom: 0.5rem; color: #fff;">Tech Tree Version Editor</h1>
    <span class="badge badge-pill-outline" style="align-self: center; margin-bottom: 1rem;">Scheduled for Batch 19</span>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
        Visual draft management, ranks, vehicle entries, coordinate placement, and progression prerequisite edge manipulation will be available here in Batch 19.
    </p>
    <div>
        <a asp-page="/Index" class="btn btn-primary">Return to Dashboard</a>
    </div>
</div>

