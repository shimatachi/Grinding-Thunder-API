@page "/Trees/Diff"
@model GrindingThunder.Admin.Pages.Trees.DiffModel
@{ ViewData["Title"] = "Compare versions"; }
<div class="page-header"><div class="row align-items-center"><div class="col"><h1 class="page-title">Compare versions</h1><div class="text-secondary">@Model.TreeLabel</div></div><div class="col-auto"><a asp-page="/Trees" asp-route-researchTreeId="@Model.ResearchTreeId" class="btn btn-outline-secondary">Back to versions</a></div></div></div>
@if (Model.ErrorMessage is not null) { <div class="alert alert-danger mt-3">@Model.ErrorMessage</div> }
<div class="card mt-3"><div class="card-body"><form method="get" class="row g-3 align-items-end">
    <input type="hidden" name="researchTreeId" value="@Model.ResearchTreeId" />
    <div class="col-md-5"><label for="sourceVersionId" class="form-label">Base version</label><select id="sourceVersionId" name="sourceVersionId" class="form-select" required><option value="">Select base</option>@foreach (var version in Model.Versions) { <option value="@version.Id" selected="@(version.Id == Model.SourceVersionId)">@version.UpdateVersion (@(version.Status == 1 ? "Published" : "Draft"))</option> }</select></div>
    <div class="col-md-5"><label for="targetVersionId" class="form-label">Target version</label><select id="targetVersionId" name="targetVersionId" class="form-select" required><option value="">Select target</option>@foreach (var version in Model.Versions) { <option value="@version.Id" selected="@(version.Id == Model.TargetVersionId)">@version.UpdateVersion (@(version.Status == 1 ? "Published" : "Draft"))</option> }</select></div>
    <div class="col-md-2"><button type="submit" class="btn btn-primary">Compare</button></div>
</form></div></div>
@if (Model.Diff is not null) {
    <div class="card mt-3"><div class="card-header"><h3 class="card-title">Economic summary: @Model.Diff.SourceGameUpdateVersion → @Model.Diff.TargetGameUpdateVersion</h3></div><div class="card-body"><div class="row g-3">
        <div class="col-auto">Net RP delta: <strong>@Model.Diff.Summary.NetRpDelta.ToString("+0;-0;0")</strong></div><div class="col-auto">Net SL delta: <strong>@Model.Diff.Summary.NetSlDelta.ToString("+0;-0;0")</strong></div>
        <div class="col-auto">Added: @Model.Diff.Summary.AddedVehiclesCount</div><div class="col-auto">Removed: @Model.Diff.Summary.RemovedVehiclesCount</div><div class="col-auto">Modified: @Model.Diff.Summary.ModifiedVehiclesCount</div>
    </div></div></div>
    <div class="card mt-3"><div class="card-header"><h3 class="card-title">Vehicle changes</h3></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Change</th><th>Vehicle</th><th>Rank</th><th>RP</th><th>SL</th><th>Other changes</th></tr></thead><tbody>
        @foreach (var vehicle in Model.Diff.AddedVehicles) { <tr><td><span class="badge bg-green-lt">Added</span></td><td>@vehicle.Name</td><td>@vehicle.Rank</td><td>@vehicle.RpCost</td><td>@vehicle.SlCost</td><td></td></tr> }
        @foreach (var vehicle in Model.Diff.RemovedVehicles) { <tr><td><span class="badge bg-red-lt">Removed</span></td><td>@vehicle.Name</td><td>@vehicle.Rank</td><td>@vehicle.RpCost</td><td>@vehicle.SlCost</td><td></td></tr> }
        @foreach (var vehicle in Model.Diff.ModifiedVehicles) { <tr><td><span class="badge bg-blue-lt">Modified</span></td><td>@vehicle.Name</td><td>@vehicle.OldRankNumber → @vehicle.NewRankNumber</td><td>@vehicle.OldRpCost → @vehicle.NewRpCost (@vehicle.RpDelta.ToString("+0;-0;0"))</td><td>@vehicle.OldSlCost → @vehicle.NewSlCost (@vehicle.SlDelta.ToString("+0;-0;0"))</td><td>Acquisition: @vehicle.OldAcquisitionType → @vehicle.NewAcquisitionType; position: (@vehicle.OldColumn, @vehicle.OldRow) → (@vehicle.NewColumn, @vehicle.NewRow); folder parent: @vehicle.OldParentVehicleId → @vehicle.NewParentVehicleId</td></tr> }
        @if (Model.Diff.AddedVehicles.Count + Model.Diff.RemovedVehicles.Count + Model.Diff.ModifiedVehicles.Count == 0) { <tr><td colspan="6">No vehicle changes.</td></tr> }
    </tbody></table></div></div>
    <div class="card mt-3"><div class="card-header"><h3 class="card-title">Prerequisite changes</h3></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Change</th><th>Vehicle</th><th>Prerequisite</th></tr></thead><tbody>
        @foreach (var edge in Model.Diff.AddedPrerequisites) { <tr><td><span class="badge bg-green-lt">Added</span></td><td>@edge.VehicleName</td><td>@edge.PrerequisiteVehicleName</td></tr> }
        @foreach (var edge in Model.Diff.RemovedPrerequisites) { <tr><td><span class="badge bg-red-lt">Removed</span></td><td>@edge.VehicleName</td><td>@edge.PrerequisiteVehicleName</td></tr> }
        @if (Model.Diff.AddedPrerequisites.Count + Model.Diff.RemovedPrerequisites.Count == 0) { <tr><td colspan="3">No prerequisite changes.</td></tr> }
    </tbody></table></div></div>
    <div class="card mt-3"><div class="card-header"><h3 class="card-title">Rank gate changes</h3></div><div class="table-responsive"><table class="table table-vcenter card-table"><thead><tr><th>Rank</th><th>Change</th><th>Required vehicles unlocked</th></tr></thead><tbody>
        @foreach (var rank in Model.Diff.RankChanges) { <tr><td>@rank.RankNumber</td><td>@rank.ChangeType</td><td>@rank.OldRequiredVehiclesUnlocked → @rank.NewRequiredVehiclesUnlocked</td></tr> }
        @if (Model.Diff.RankChanges.Count == 0) { <tr><td colspan="3">No rank gate changes.</td></tr> }
    </tbody></table></div></div>
}
