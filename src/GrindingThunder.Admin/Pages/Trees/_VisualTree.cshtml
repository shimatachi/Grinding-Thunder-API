@model VisualTreeWorkspaceViewModel
@functions {
    private static string FormatRankLabel(int rankNumber)
    {
        if (rankNumber <= 0 || rankNumber > 3999)
            return rankNumber.ToString(System.Globalization.CultureInfo.InvariantCulture);

        var values = new (int Value, string Numeral)[]
        {
            (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"),
            (100, "C"), (90, "XC"), (50, "L"), (40, "XL"),
            (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")
        };
        var remaining = rankNumber;
        var result = new System.Text.StringBuilder();
        foreach (var (value, numeral) in values)
        {
            while (remaining >= value)
            {
                result.Append(numeral);
                remaining -= value;
            }
        }

        return result.ToString();
    }
}
@{
    var tree = Model.Tree;
    const int columnStep = 280;
    const int rowStep = 204;
    var stageWidth = Math.Max(960, ((tree.MaximumTreeColumn + 1) * columnStep) + 240);
}

<div class="visual-tree-workspace"
     data-visual-tree
     data-can-edit="@Model.CanEdit.ToString().ToLowerInvariant()"
     data-start-edge-mode="@Model.StartInEdgeMode.ToString().ToLowerInvariant()"
     data-start-selected-edge="@Model.StartWithSelectedEdge.ToString().ToLowerInvariant()"
     data-pending-dependent="@Model.PendingDependentEntryId"
     data-pending-prerequisite="@Model.PendingPrerequisiteEntryId"
     data-tree-column-step="@columnStep"
     data-tree-row-step="@rowStep"
     style="--visual-tree-column-step: @(columnStep)px; --visual-tree-row-step: @(rowStep)px">
    <div class="visual-tree-main">
        <div class="card visual-tree-card">
            <div class="card-header flex-wrap gap-3">
                <div>
                    <h3 class="card-title">Visual research tree</h3>
                    <div class="text-secondary small">
                        @(Model.CanEdit
                            ? "Inspect the snapshot, or enable Edit Mode to select and move entries."
                            : "Read-only snapshot layout. Progression comes from explicit prerequisites, not node proximity.")
                    </div>
                </div>
                <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                    @if (Model.CanEdit)
                    {
                        <label class="form-check form-switch mb-0 visual-tree-edit-toggle">
                            <input class="form-check-input" type="checkbox" role="switch" data-tree-edit-toggle />
                            <span class="form-check-label fw-semibold">Edit mode</span>
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-tree-edge-toggle aria-pressed="false">
                            Edit prerequisites
                        </button>
                        <span class="badge bg-blue-lt d-none" data-tree-edge-mode-indicator>Prerequisite mode</span>
                    }
                    <div class="btn-list visual-tree-controls" aria-label="Tree viewport controls">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-zoom-out aria-label="Zoom out">−</button>
                        <span class="visual-tree-zoom-label" data-tree-zoom-label aria-live="polite">100%</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-zoom-in aria-label="Zoom in">+</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-fit>Fit</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-reset>Reset</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-tree-focus-toggle aria-pressed="false">Focus mode</button>
                    </div>
                </div>
            </div>
            <div class="card-body py-2 visual-tree-legend" aria-label="Tree relationship legend">
                <span><i class="visual-tree-legend-line visual-tree-legend-line-prerequisite"></i> Progression prerequisite</span>
                <span><i class="visual-tree-legend-line visual-tree-legend-line-folder"></i> Folder / group membership</span>
                @if (!Model.CanEdit)
                {
                    <span class="d-none d-md-inline-flex align-items-center gap-1 ms-2 ps-2 border-start">
                        <span class="badge bg-green-lt">Owned</span>
                        <span class="badge bg-orange text-white">Target</span>
                        <span class="badge bg-blue text-white">Required</span>
                        <span class="badge bg-purple text-white">Filler</span>
                    </span>
                }
                <span class="text-secondary ms-auto" data-tree-help>
                    @(Model.CanEdit
                        ? "Drag empty space to pan · enable Edit Mode to select nodes"
                        : "Click a vehicle to select target · use quick buttons to toggle ownership")
                </span>
            </div>
            @if (Model.CanEdit)
            {
                <div class="card-body py-2 visual-tree-layout-toolbar" data-tree-layout-toolbar aria-label="Layout assistance tools">
                    <div class="btn-list" role="group" aria-label="History actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-undo title="Undo (Ctrl+Z)" disabled>Undo</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-redo title="Redo (Ctrl+Y)" disabled>Redo</button>
                    </div>
                    <label class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" checked data-tree-grid-snap />
                        <span class="form-check-label">Snap while dragging</span>
                    </label>
                    <span class="badge bg-blue-lt" data-tree-selection-count aria-live="polite">0 selected</span>
                    <div class="btn-list" role="group" aria-label="Align selected entries">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-action="align-column" disabled>Align column</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-action="align-row" disabled>Align row</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-action="distribute-vertical" disabled>Distribute vertically</button>
                    </div>
                    <div class="btn-list" role="group" aria-label="Move selected entries">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-nudge="left" aria-label="Move selection left" disabled>←</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-nudge="right" aria-label="Move selection right" disabled>→</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-nudge="up" aria-label="Move selection up" disabled>↑</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-nudge="down" aria-label="Move selection down" disabled>↓</button>
                    </div>
                    <form method="post" asp-page-handler="UpdateLayout" class="d-inline" data-tree-layout-form>
                        <div data-tree-layout-fields></div>
                        <button type="submit" class="btn btn-sm btn-primary" data-tree-layout-save disabled>Save layout</button>
                    </form>
                    <span class="small text-secondary d-none" role="status" aria-live="polite" data-tree-layout-status></span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-layout-discard disabled>Discard layout</button>
                    <div class="alert alert-danger py-1 px-2 mb-0 d-none d-flex align-items-center flex-wrap gap-2" role="alert" data-tree-collision-warning aria-live="assertive">
                        <span>Resolve highlighted layout issues:</span>
                        <span data-tree-collision-list class="d-inline-flex flex-wrap gap-1"></span>
                    </div>
                    <span class="text-secondary small ms-auto">Ctrl/Command or Shift-click up to 12 entries in one rank.</span>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger m-3 mb-0" role="alert" data-tree-workspace-alert>@Model.ErrorMessage</div>
            }
            @if (tree.IsEmpty)
            {
                <div class="empty-message">This version has no vehicle entries to display.</div>
            }
            else
            {
                <div class="visual-tree-viewport" data-tree-viewport tabindex="0" aria-label="Scrollable visual research tree">
                    <div class="visual-tree-surface" data-tree-surface>
                        <div class="visual-tree-stage" data-tree-stage style="width: @(stageWidth)px">
                            <svg class="visual-tree-connectors" data-tree-connectors aria-hidden="@(!Model.CanEdit).ToString().ToLowerInvariant()">
                                <defs>
                                    <marker id="visual-tree-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth">
                                        <path d="M 0 0 L 8 4 L 0 8 z" class="visual-tree-arrowhead"></path>
                                    </marker>
                                </defs>
                                <g data-tree-paths></g>
                            </svg>
                            <div class="d-none" aria-hidden="true" data-tree-edge-data>
                                @foreach (var edge in tree.Edges)
                                {
                                    <span data-tree-edge
                                          data-from-node="@edge.FromNodeId"
                                          data-to-node="@edge.ToNodeId"
                                          data-edge-kind="@edge.Kind.ToString().ToLowerInvariant()"></span>
                                }
                            </div>
                            @for (var rankIndex = 0; rankIndex < tree.Ranks.Count; rankIndex++)
                            {
                                var rank = tree.Ranks[rankIndex];
                                var rankLabel = FormatRankLabel(rank.RankNumber);
                                var rowCount = Math.Max(1, rank.MaximumTreeRow - rank.MinimumTreeRow + 1);
                                var rankHeight = (rowCount * rowStep) + 96;
                                <section class="visual-tree-rank visual-tree-rank-band-@(rankIndex % 2 == 0 ? "even" : "odd")"
                                         data-tree-rank="@rank.RankNumber"
                                         data-tree-rank-label="@rankLabel"
                                         data-tree-rank-id="@rank.Id"
                                         data-tree-min-row="@rank.MinimumTreeRow"
                                         data-tree-grid-guide
                                         style="min-height: @(rankHeight)px">
                                    <header class="visual-tree-rank-header">
                                        <span class="visual-tree-rank-kicker">Research tier</span>
                                        <span class="visual-tree-rank-number">Rank <strong>@rankLabel</strong></span>
                                        @if (rank.RequiredVehiclesUnlocked > 0)
                                        {
                                            <span class="visual-tree-rank-quota">
                                                Requires <strong>@rank.RequiredVehiclesUnlocked</strong> vehicles to unlock Rank @rankLabel
                                            </span>
                                        }
                                    </header>
                                    <div class="visual-tree-rank-grid">
                                        @if (rank.Nodes.Count == 0)
                                        {
                                            <div class="visual-tree-empty-rank">No entries in this rank</div>
                                        }
                                        @foreach (var node in rank.Nodes)
                                        {
                                            var acquisitionClass = $"visual-tree-acquisition-{node.AcquisitionType.ToString().ToLowerInvariant()}";
                                            var folderClass = node.IsFolderParent ? "visual-tree-node-folder-parent" :
                                                node.FolderParentId.HasValue ? "visual-tree-node-folder-child" : string.Empty;
                                            <article id="@node.DomId"
                                                     class="visual-tree-node visual-tree-node-acquisition-@node.AcquisitionType.ToString().ToLowerInvariant() @folderClass"
                                                     data-tree-node="@node.Id"
                                                     data-vehicle-id="@node.VehicleId"
                                                     data-vehicle-name="@node.Name"
                                                     data-image-url="@node.ImageUrl"
                                                     data-wiki-url="@node.WikiUrl"
                                                     data-tree-rank-id="@node.TreeRankId"
                                                     data-rp-cost="@node.RpCost"
                                                     data-sl-cost="@node.SlCost"
                                                     data-tree-column="@node.TreeColumn"
                                                     data-tree-row="@node.TreeRow"
                                                     data-acquisition-type="@((int)node.AcquisitionType)"
                                                     data-folder-parent-id="@node.FolderParentId"
                                                     data-is-folder-parent="@node.IsFolderParent.ToString().ToLowerInvariant()"
                                                     data-tree-rank-number="@node.RankNumber"
                                                     tabindex="0"
                                                     style="--tree-column: @node.TreeColumn; --tree-row: @node.RowOffset; --tree-stack: @node.CoordinateStackIndex">
                                                @if (!Model.CanEdit)
                                                {
                                                    <div class="visual-tree-node-actions" data-node-actions>
                                                        <button type="button" class="visual-tree-node-quick-btn visual-tree-node-owned-btn" data-node-owned-toggle title="Toggle owned (researched)" aria-label="Toggle owned">✓</button>
                                                        <button type="button" class="visual-tree-node-quick-btn visual-tree-node-target-btn" data-node-target-toggle title="Set as target vehicle" aria-label="Set as target">🎯</button>
                                                    </div>
                                                }
                                                <div class="visual-tree-node-image">
                                                    @if (!string.IsNullOrWhiteSpace(node.ImageUrl))
                                                    {
                                                        <img src="@node.ImageUrl" alt="" loading="lazy" />
                                                    }
                                                    else
                                                    {
                                                        <span aria-hidden="true">No image</span>
                                                    }
                                                </div>
                                                <div class="visual-tree-node-body">
                                                    <div class="visual-tree-node-name" title="@node.Name">@node.Name</div>
                                                    <div class="visual-tree-node-meta">
                                                        <span data-tree-rank-preview>Rank @FormatRankLabel(node.RankNumber)</span>
                                                        <span class="visual-tree-acquisition-badge @acquisitionClass" data-tree-acquisition-preview>@node.AcquisitionType</span>
                                                    </div>
                                                    <div class="visual-tree-node-costs">
                                                        <span title="Research Points" data-tree-rp-preview>@node.RpCost.ToString("N0") RP</span>
                                                        <span title="Silver Lions" data-tree-sl-preview>@node.SlCost.ToString("N0") SL</span>
                                                    </div>
                                                    <div class="visual-tree-node-badges">
                                                        <span class="badge d-none visual-tree-progression-badge" data-progression-badge></span>
                                                        @if (node.IsFolderParent)
                                                        {
                                                            <span class="badge bg-azure-lt">Folder</span>
                                                        }
                                                        @if (node.FolderParentId.HasValue)
                                                        {
                                                            <span class="badge bg-azure-lt">Folder member</span>
                                                        }
                                                    </div>
                                                </div>
                                                <span class="visual-tree-node-coordinate" data-tree-coordinate aria-label="Tree position: column @(node.TreeColumn + 1), row @(node.TreeRow + 1)">Column @(node.TreeColumn + 1) · Row @(node.TreeRow + 1)</span>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (Model.CanEdit)
    {
        <aside class="visual-tree-sidebar" data-tree-sidebar aria-label="Visual tree editor">
            <div class="card d-none" data-tree-edge-panel>
                <div class="card-header"><h3 class="card-title">Prerequisite editor</h3></div>
                <div class="alert alert-info m-3 mb-0 d-none" role="status" aria-live="polite" data-tree-edge-status></div>
                <div class="card-body" data-tree-edge-empty>
                    <p class="mb-2">Select the dependent vehicle first, then select the prerequisite it requires.</p>
                    <div class="text-secondary small">Existing blue prerequisite edges can also be selected for removal. Press Esc to leave this mode.</div>
                </div>
                <div class="card-body d-none" data-tree-edge-pending>
                    <div class="mb-2"><span class="text-secondary">Dependent:</span> <strong data-tree-edge-dependent-name></strong></div>
                    <div><span class="text-secondary">Requires:</span> <strong data-tree-edge-prerequisite-name>select a prerequisite</strong></div>
                    <div class="form-hint mt-3">The dashed preview is not persisted until you save it.</div>
                </div>
                <form method="post" asp-page-handler="AddPrerequisite" class="card-footer d-none" data-tree-edge-create-form>
                    <input type="hidden" name="AddPrerequisite.VehicleTreeEntryId" data-tree-edge-dependent-input />
                    <input type="hidden" name="AddPrerequisite.PrerequisiteVehicleTreeEntryId" data-tree-edge-prerequisite-input />
                    <input type="hidden" name="VisualEdgeMode" value="true" />
                    <input type="hidden" name="VisualEdgeSelection" value="false" />
                    <button type="submit" class="btn btn-primary w-100">Create prerequisite</button>
                </form>
                <div class="card-body d-none" data-tree-edge-selected>
                    <div class="mb-2"><span class="text-secondary">Dependent:</span> <strong data-tree-selected-dependent-name></strong></div>
                    <div><span class="text-secondary">Requires:</span> <strong data-tree-selected-prerequisite-name></strong></div>
                </div>
                <form method="post" asp-page-handler="RemovePrerequisite" class="card-footer d-none" data-tree-edge-remove-form onsubmit="return confirm('Remove this prerequisite edge?');">
                    <input type="hidden" name="entryId" data-tree-edge-remove-dependent />
                    <input type="hidden" name="prerequisiteEntryId" data-tree-edge-remove-prerequisite />
                    <input type="hidden" name="AddPrerequisite.VehicleTreeEntryId" data-tree-edge-selected-dependent-input />
                    <input type="hidden" name="AddPrerequisite.PrerequisiteVehicleTreeEntryId" data-tree-edge-selected-prerequisite-input />
                    <input type="hidden" name="VisualEdgeMode" value="true" />
                    <input type="hidden" name="VisualEdgeSelection" value="true" />
                    <button type="submit" class="btn btn-outline-danger w-100">Remove prerequisite</button>
                </form>
            </div>

            <div class="card" data-tree-entry-editor data-tree-inspector>
                <div class="card-header visual-tree-inspector-header">
                    <h3 class="card-title">Entry inspector</h3>
                    <div class="btn-list ms-auto" aria-label="Navigate vehicle entries">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-previous disabled>Previous</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-next disabled>Next</button>
                    </div>
                </div>
                <div class="card-body text-secondary" data-tree-selection-empty>Select a vehicle node to inspect and edit it.</div>
                <form method="post" asp-page-handler="UpdateVisualEntry" class="d-none" data-tree-inspector-form data-dirty-track="vehicle-entry">
                    <div class="card-body">
                        <input type="hidden" name="VisualEntry.EntryId" data-inspector-entry-id />
                        <div class="alert d-none visual-tree-unsaved" role="status" aria-live="polite" data-inspector-dirty data-inspector-save-status></div>
                        <section class="visual-tree-inspector-section mb-3" data-inspector-identity>
                            <h4 class="visual-tree-inspector-section-title">Stable vehicle identity</h4>
                            <div class="visual-tree-identity">
                                <div class="visual-tree-inspector-image"><img alt="" data-inspector-image /></div>
                                <div>
                                    <div class="fw-bold" data-inspector-name></div>
                                    <div class="text-secondary small">Vehicle ID: <code data-inspector-vehicle-id></code></div>
                                    <div class="text-secondary small">@Model.ResearchTreeLabel</div>
                                    <div class="text-secondary small">Tree ID: <code>@Model.ResearchTreeId</code></div>
                                    <div class="mt-2 d-none" data-inspector-wiki-container>
                                        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" data-inspector-wiki-link>View on War Thunder Wiki ↗</a>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <section class="visual-tree-inspector-section" data-inspector-version-data>
                        <h4 class="visual-tree-inspector-section-title">Version-specific entry data</h4>
                        <div class="mb-3">
                            <label class="form-label" for="VisualEntry_TreeRankId">Rank</label>
                            <select class="form-select" id="VisualEntry_TreeRankId" name="VisualEntry.TreeRankId" data-inspector-rank data-dirty-field="treeRankId" required>
                                @foreach (var rank in Model.Ranks.OrderBy(rank => rank.RankNumber))
                                {
                                    <option value="@rank.Id">Rank @rank.RankNumber</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6"><label class="form-label" for="VisualEntry_RpCost">RP cost</label><input class="form-control" id="VisualEntry_RpCost" name="VisualEntry.RpCost" type="number" min="0" required data-inspector-rp data-dirty-field="rpCost" /></div>
                            <div class="col-6"><label class="form-label" for="VisualEntry_SlCost">SL cost</label><input class="form-control" id="VisualEntry_SlCost" name="VisualEntry.SlCost" type="number" min="0" required data-inspector-sl data-dirty-field="slCost" /></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="VisualEntry_AcquisitionType">Acquisition type</label>
                            <select class="form-select" id="VisualEntry_AcquisitionType" name="VisualEntry.AcquisitionType" data-inspector-acquisition data-dirty-field="acquisitionType">
                                @foreach (var acquisitionType in Enum.GetValues<VehicleAcquisitionType>())
                                {
                                    <option value="@((int)acquisitionType)">@acquisitionType</option>
                                }
                            </select>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6"><label class="form-label" for="VisualEntry_TreeColumn">Tree column</label><input class="form-control" id="VisualEntry_TreeColumn" name="VisualEntry.TreeColumn" type="number" min="1" step="1" required data-inspector-column data-dirty-field="treeColumn" /></div>
                            <div class="col-6"><label class="form-label" for="VisualEntry_TreeRow">Tree row</label><input class="form-control" id="VisualEntry_TreeRow" name="VisualEntry.TreeRow" type="number" min="1" step="1" required data-inspector-row data-dirty-field="treeRow" /></div>
                        </div>
                        <div class="visual-tree-coordinate-indicator mb-2" data-inspector-coordinate aria-live="polite">Column — · Row —</div>
                        <div class="btn-list mb-3" aria-label="Move selected vehicle">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-nudge="left" aria-label="Move left">←</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-nudge="right" aria-label="Move right">→</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-nudge="up" aria-label="Move up">↑</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-tree-nudge="down" aria-label="Move down">↓</button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="VisualEntry_FolderParentEntryId">Folder parent (optional)</label>
                            <select class="form-select" id="VisualEntry_FolderParentEntryId" name="VisualEntry.FolderParentEntryId" data-inspector-folder data-dirty-field="folderParentId">
                                <option value="">— none —</option>
                                @foreach (var entry in Model.Entries.OrderBy(entry => entry.VehicleName))
                                {
                                    <option value="@entry.Id">@entry.VehicleName</option>
                                }
                            </select>
                        </div>
                        <div class="form-hint">Drag the selected card, use the arrow buttons, or press an arrow key. Ctrl+Z/Ctrl+Y undo/redo, Esc deselects, Del/Backspace removes. Ctrl/Command or Shift-click adds entries from the same rank to a bounded selection. Coordinates are persisted only when saved.</div>
                        </section>
                    </div>
                    <div class="card-footer"><button type="submit" class="btn btn-primary w-100">Save Changes</button></div>
                </form>
                <form method="post" asp-page-handler="DeleteEntry" class="d-none card-footer pt-0" data-tree-remove-form onsubmit="return confirm('Remove this vehicle from the draft?');">
                    <input type="hidden" name="entryId" data-remove-entry-id />
                    <button type="submit" class="btn btn-outline-danger w-100">Remove from Draft</button>
                </form>
            </div>

            <div class="card mt-3" data-tree-entry-editor>
                <div class="card-header"><h3 class="card-title">Add vehicle</h3></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="AddEntry" data-tree-add-existing>
                        <h4>Existing tree vehicle</h4>
                        <div class="mb-3">
                            <label class="form-label" for="VisualAdd_VehicleId">Vehicle not in this draft</label>
                            <select class="form-select" id="VisualAdd_VehicleId" name="AddEntry.VehicleId" required>
                                <option value="">— select vehicle —</option>
                                @foreach (var vehicle in Model.AvailableVehicles)
                                {
                                    <option value="@vehicle.Id">@vehicle.Name</option>
                                }
                            </select>
                        </div>
                        <partial name="/Pages/Trees/_VisualEntryFields.cshtml" model="@(new VisualEntryFieldsViewModel("AddEntry", "VisualAdd", Model.Ranks, Model.Entries))" />
                        <button type="submit" class="btn btn-primary w-100">Add to Draft</button>
                    </form>

                    <hr class="my-4" />

                    <form method="post" asp-page-handler="CreateAndAddEntry" data-tree-create-entry>
                        <h4>Create in @Model.ResearchTreeLabel</h4>
                        <div class="mb-3"><label class="form-label" for="CreateEntry_Name">Vehicle name</label><input class="form-control" id="CreateEntry_Name" name="CreateEntry.Name" required /></div>
                        <div class="mb-3"><label class="form-label" for="CreateEntry_ImageUrl">Image URL (optional)</label><input class="form-control" id="CreateEntry_ImageUrl" name="CreateEntry.ImageUrl" type="url" /></div>
                        <div class="mb-3"><label class="form-label" for="CreateEntry_WikiUrl">Wiki URL (optional)</label><input class="form-control" id="CreateEntry_WikiUrl" name="CreateEntry.WikiUrl" type="url" placeholder="https://wiki.warthunder.com/..." /></div>
                        <partial name="/Pages/Trees/_VisualEntryFields.cshtml" model="@(new VisualEntryFieldsViewModel("CreateEntry", "VisualCreate", Model.Ranks, Model.Entries))" />
                        <button type="submit" class="btn btn-primary w-100">Create and Add</button>
                    </form>
                </div>
            </div>
        </aside>
    }
    else
    {
        <aside class="visual-tree-sidebar" data-tree-readonly-inspector aria-label="Selected vehicle details">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Vehicle details</h3>
                    <button type="button" class="btn-close ms-auto" data-tree-readonly-close aria-label="Close vehicle details"></button>
                </div>
                <div class="card-body text-secondary" data-tree-readonly-empty>Select a vehicle card to inspect it.</div>
                <div class="card-body d-none" data-tree-readonly-details>
                    <div class="visual-tree-identity mb-3">
                        <div class="visual-tree-inspector-image"><img alt="" data-readonly-image /></div>
                        <div>
                            <div class="fw-bold" data-readonly-name></div>
                            <div class="text-secondary small">Vehicle ID: <code data-readonly-vehicle-id></code></div>
                            <div class="text-secondary small">@Model.ResearchTreeLabel</div>
                            <div class="mt-2 d-none" data-readonly-wiki-container>
                                <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary" data-readonly-wiki-link>View on War Thunder Wiki ↗</a>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 d-flex flex-wrap gap-2">
                        <span class="badge bg-secondary-lt" data-readonly-progression-badge>Unresearched</span>
                    </div>
                    <div class="btn-list mb-3">
                        <button type="button" class="btn btn-sm btn-outline-success w-100" data-readonly-toggle-owned>Toggle Owned</button>
                        <button type="button" class="btn btn-sm btn-primary w-100" data-readonly-set-target>Set as Target</button>
                    </div>
                    <dl class="row mb-0">
                        <dt class="col-6">Rank</dt><dd class="col-6" data-readonly-rank></dd>
                        <dt class="col-6">RP cost</dt><dd class="col-6" data-readonly-rp></dd>
                        <dt class="col-6">SL cost</dt><dd class="col-6" data-readonly-sl></dd>
                        <dt class="col-6">Acquisition</dt><dd class="col-6" data-readonly-acquisition></dd>
                        <dt class="col-6">Position</dt><dd class="col-6" data-readonly-coordinate></dd>
                        <dt class="col-6">Folder</dt><dd class="col-6" data-readonly-folder></dd>
                    </dl>
                </div>
            </div>
        </aside>
    }
</div>
